<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a clean-streak ring with a green core,
     kept inside the adaptive-icon safe zone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="center">
        <shape android:shape="oval">
            <stroke
                android:width="6.5dp"
                android:color="#FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="21dp"
        android:height="21dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#34d399" />
        </shape>
    </item>
</layer-list>
