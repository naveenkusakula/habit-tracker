<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the app's gradient with a clean-streak ring and core. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#3b2f8f"
                android:centerColor="#1b2a6b"
                android:endColor="#0e7c86"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:gravity="center">
        <shape android:shape="oval">
            <stroke
                android:width="7dp"
                android:color="#FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#34d399" />
        </shape>
    </item>
</layer-list>
